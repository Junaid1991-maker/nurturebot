{
  "name": "NurtureBot Daily Run",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "triggerAtHour": 9 } ] }
      },
      "name": "Every day 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {},
      "name": "Run now (testing)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8007/run-daily",
        "options": { "timeout": 600000 }
      },
      "name": "NurtureBot /run-daily",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "or",
          "conditions": [
            {
              "leftValue": "={{ $json.failed }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        },
        "options": {}
      },
      "name": "Any failures?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [600, 100]
    }
  ],
  "connections": {
    "Every day 9 AM": { "main": [ [ { "node": "NurtureBot /run-daily", "type": "main", "index": 0 } ] ] },
    "Run now (testing)": { "main": [ [ { "node": "NurtureBot /run-daily", "type": "main", "index": 0 } ] ] },
    "NurtureBot /run-daily": { "main": [ [ { "node": "Any failures?", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "timezone": "Asia/Karachi", "executionOrder": "v1" }
}
